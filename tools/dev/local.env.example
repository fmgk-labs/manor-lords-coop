# This PC's own paths for the developer tools (tools/dev/*.sh, tools/*.ps1, native/coop_patch/build.cmd test).
# Copy this file to tools/dev/local.env (git-ignored: it never goes into the repository) and fill in your paths.
# Format: NAME=value, one per line, no spaces around "=". Windows paths, with / or \ (quotes are optional).
# A git worktree without its own local.env uses the main checkout's. An environment variable of the same name wins.

# The folder that holds your TEST copies of the game. Never your real Steam install: the tools refuse it.
#   <ML_TEST_ROOT>/_ml_test                   the lead's copy (lane 0): a full copy of your "Manor Lords" game folder
#   <ML_TEST_ROOT>/_ml_test_1 ... _ml_test_9  the parallel lanes' copies (LANE=n sh tools/dev/lane_setup.sh makes them)
ML_TEST_ROOT=C:/path/to/ml-test-copies

# The game-slot folder: the queue that limits how many game copies run at once on this PC. One folder for every
# checkout and worktree on this PC (it holds only small marker files). The tools delete folders inside it, so its
# name must contain "_ml_slots" and its path must have no spaces (the tools refuse it otherwise).
ML_SLOTS=C:/path/to/ml-test-copies/_ml_slots

# Your main checkout of this repository. Native DLLs are built there (native/*/out/); worktrees take them from it.
ML_REPO=C:/path/to/manor-lords-coop
